<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <PtclLibRoot Condition="'$(PtclLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\lib</PtclLibRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PtclSharp\PtclSharp.csproj" />
    <ProjectReference Include="..\..\src\PtclSharp.Shaders\PtclSharp.Shaders.csproj" />
    <!-- ShaderLibrary reads BNSH archives and decompiles Tegra bytecode to GLSL. -->
    <ProjectReference Include="$(PtclLibRoot)\ShaderLibrary\ShaderLibrary.CompileTool\ShaderLibrary.CompileTool.csproj" />
  </ItemGroup>

</Project>
